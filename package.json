{
  "name": "jeby-lighting-lab",
  "version": "0.3.0",
  "private": true,
  "description": "Local RGB keyboard lighting editor: detect your keyboard, pick a look, and watch it light up live. Razer Chroma live control, app-aware profiles, and portable presets.",
  "license": "GPL-3.0-only",
  "author": "James Eby (jeby Labs)",
  "repository": {
    "type": "git",
    "url": "https://github.com/jameseby21/Lighting-Lab.git"
  },
  "bugs": {
    "url": "https://github.com/jameseby21/Lighting-Lab/issues"
  },
  "keywords": [
    "rgb",
    "keyboard",
    "razer",
    "chroma",
    "lighting",
    "synapse"
  ],
  "scripts": {
    "start": "node server.cjs --open",
    "start:lan": "node server.cjs --open --lan",
    "serve": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser-check.cjs",
    "test:all": "npm test && npm run test:browser",
    "build:portable": "node tests/build-portable.cjs",
    "test:native-diagnostic": "node tests/build-native-diagnostic.cjs",
    "check:live": "node tests/check-live.cjs",
    "check:download": "node tests/check-download.cjs",
    "check:connect": "node tests/check-connect.cjs",
    "format": "npx --yes prettier@3.3.3 --write .",
    "format:check": "npx --yes prettier@3.3.3 --check ."
  },
  "engines": {
    "node": ">=22"
  }
}
