# Editors pick these up automatically; they match .prettierrc.json and .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# cmd.exe mis-parses LF-only batch files (labels and parenthesised blocks near 512-byte
# boundaries), and Windows PowerShell 5.1 is happiest with CRLF too.
[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.cs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
